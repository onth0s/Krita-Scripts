<?xml version="1.0" encoding="UTF-8"?>
<ActionCollection version="2" name="Scripts">
    <Actions category="Scripts">
        <text>Operations Pie Menu</text>
        <Action name="trigger_operations_pie_menu">
            <icon></icon>
            <text>Operations Pie Menu</text>
            <whatsThis>Opens 4-sector Blender-style radial Operations Pie Menu for Krita canvas workflow.</whatsThis>
            <toolTip>Open Operations Pie Menu</toolTip>
            <iconText>OpsPie</iconText>
            <activationFlags>00000</activationFlags>
            <shortcut>Ctrl+Space</shortcut>
            <isCheckable>false</isCheckable>
            <statusTip></statusTip>
        </Action>
        <Action name="configure_operations_pie_menu">
            <icon></icon>
            <text>Configure Operations Pie Menu</text>
            <whatsThis>Opens Configurator dialog for Operations Pie Menu.</whatsThis>
            <toolTip>Configure Operations Pie Menu</toolTip>
            <iconText>CfgOpsPie</iconText>
            <activationFlags>00000</activationFlags>
            <shortcut></shortcut>
            <isCheckable>false</isCheckable>
            <statusTip></statusTip>
        </Action>
    </Actions>
</ActionCollection>
